# Server and admin access
PORT=8787
HOST=0.0.0.0
AGENT_ADMIN_TOKEN=change-me
AGENT_SESSION_SECRET=change-me-to-a-long-random-value
AGENT_CORS_ORIGIN=http://localhost:5173
DEFAULT_ORGANIZATION_ID=org_default
ORGANIZATION_NAME=锦衣卫科技
ORGANIZATION_SLUG=jinyiwei
SEED_DEFAULT_DIRECTORY=false
HTTP_RATE_LIMIT_PER_MINUTE=600

# First administrator account. Set before the first server start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-12-character-password
ADMIN_DISPLAY_NAME=企业管理员
AUTH_SESSION_TTL_SECONDS=28800

# Qwen 3.7 Plus through Alibaba Cloud Model Studio / DashScope
DASHSCOPE_API_KEY=replace-with-your-api-key
AI_MODEL=qwen3.7-plus
AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_MAX_REQUESTS_PER_MINUTE=30
AI_MAX_INPUT_RECORDS=200
AI_REQUEST_TIMEOUT_MS=60000
AI_ENABLE_THINKING=false
AI_SUMMARY_WINDOW_SECONDS=600
AI_ACTIVE_GRACE_SECONDS=45
AI_GENERATION_BATCH_SIZE=1
MEMORY_MATERIALIZATION_INTERVAL_MS=60000

# Optional: set true only when an API key is available.
AI_ENABLED=true
