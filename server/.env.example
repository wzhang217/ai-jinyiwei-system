# Server and admin access
PORT=8787
HOST=0.0.0.0
HEALTHCHECK_HOST=127.0.0.1
# Local/Docker example paths. Production preflight requires absolute persistent paths.
AGENT_DB_PATH=./data/agent.sqlite
AGENT_ADMIN_TOKEN=change-me
# Keep false in production. Set true only for a short, controlled maintenance window.
AGENT_ALLOW_BOOTSTRAP_TOKEN=false
AGENT_SESSION_SECRET=change-me-to-a-long-random-value
AGENT_CORS_ORIGIN=http://localhost:5173
DEFAULT_ORGANIZATION_ID=org_default
ORGANIZATION_NAME=锦衣卫科技
ORGANIZATION_SLUG=jinyiwei
SEED_DEFAULT_DIRECTORY=false
HTTP_RATE_LIMIT_PER_MINUTE=600

# First administrator account. Set before the first server start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-12-character-password
ADMIN_DISPLAY_NAME=企业管理员
AUTH_JWT_TTL_SECONDS=28800

# Qwen 3.7 Plus through Alibaba Cloud Model Studio / DashScope
DASHSCOPE_API_KEY=replace-with-your-api-key
AI_MODEL=qwen3.7-plus
AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_MAX_REQUESTS_PER_MINUTE=30
AI_MAX_INPUT_RECORDS=200
AI_REQUEST_TIMEOUT_MS=60000
AI_ENABLE_THINKING=false
# Optional脱敏告警 webhook；只发送模型失败、额度阻断和额度预警，不发送活动内容。
AI_ALERT_WEBHOOK_URL=
AI_ALERT_COOLDOWN_SECONDS=1800
AI_BUDGET_ALERT_RATIO=0.8
AI_REQUEST_ALERT_RATIO=0.8
# Optional provider pricing in USD per 1M tokens; leave 0 when unknown.
AI_INPUT_COST_PER_MILLION_TOKENS=0
AI_OUTPUT_COST_PER_MILLION_TOKENS=0
AI_SUMMARY_WINDOW_SECONDS=600
AI_ACTIVE_GRACE_SECONDS=45
AI_GENERATION_BATCH_SIZE=1
MEMORY_MATERIALIZATION_INTERVAL_MS=60000
AGENT_BACKUP_DIR=./data/backups
AGENT_BACKUP_RETENTION_DAYS=14
# Health checks fail when the database filesystem has less free space than this.
DISK_MIN_FREE_BYTES=1073741824
# Optional generic JSON webhook for health failures. Leave empty to keep the
# alert in the system journal only.
HEALTH_ALERT_WEBHOOK_URL=
HEALTH_ALERT_COOLDOWN_SECONDS=1800

# Optional: set true only when an API key is available.
AI_ENABLED=true
