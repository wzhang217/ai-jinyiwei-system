{
  "name": "ai-jinyiwei-agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-sqlite src/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch --experimental-sqlite src/index.mjs",
    "backup": "node --env-file-if-exists=.env --experimental-sqlite scripts/backup.mjs",
    "backup:rotate": "node --env-file-if-exists=.env --experimental-sqlite scripts/backup-rotate.mjs",
    "restore-check": "node --env-file-if-exists=.env --experimental-sqlite scripts/restore-check.mjs",
    "provision:organization": "node --env-file-if-exists=.env --experimental-sqlite scripts/provision-organization.mjs",
    "directory:import": "node --env-file-if-exists=.env --experimental-sqlite scripts/import-directory.mjs",
    "diagnostics": "node --env-file-if-exists=.env --experimental-sqlite scripts/diagnostics.mjs",
    "ops:check": "node --env-file-if-exists=.env --experimental-sqlite scripts/ops-check.mjs",
    "ai:eval": "node --env-file-if-exists=.env scripts/evaluate-ai.mjs",
    "preflight:production": "node --env-file-if-exists=.env scripts/preflight-production.mjs",
    "healthcheck": "node --env-file-if-exists=.env scripts/healthcheck.mjs",
    "test": "node --test --experimental-sqlite tests/server.test.mjs"
  }
}
