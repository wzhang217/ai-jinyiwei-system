[Unit]
Description=AI锦衣卫 Agent Server verified SQLite backup
After=ai-jinyiwei-agent-server.service
Requires=ai-jinyiwei-agent-server.service

[Service]
Type=oneshot
User=jinyiwei
Group=jinyiwei
WorkingDirectory=/opt/ai-jinyiwei/server
EnvironmentFile=/etc/ai-jinyiwei/server.env
ExecStart=/usr/bin/node --env-file-if-exists=.env --experimental-sqlite scripts/backup-rotate.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ai-jinyiwei/server/data
SyslogIdentifier=ai-jinyiwei-agent-backup
